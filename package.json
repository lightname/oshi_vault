{
  "name": "oshi-vault",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/gen-sitemap.mjs",
    "preview": "node scripts/serve-out.mjs",
    "data": "node scripts/build-data.mjs",
    "data:check": "node scripts/build-data.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "npm run build && playwright test --project=e2e",
    "qa:shots": "npm run build && playwright test --project=qa",
    "og": "playwright test --project=og",
    "placeholders": "node scripts/gen-placeholders.mjs",
    "seo:check": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "gray-matter": "4.0.3",
    "marked": "18.1.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "exceljs": "4.4.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
